// Full domain data model for task 1.3 (Requirements: 9.1, 9.3).
// Physical shape follows design.md "Physical Data Model" exactly (table/column
// names, indexes, unique constraints). `non_business_days.date_active_key` is a
// MySQL STORED GENERATED COLUMN that Prisma cannot express natively, so it is
// modeled as Unsupported() here; the actual column + unique index are added by
// hand-editing the generated migration SQL (see design.md Physical Data Model
// and research.md for the MySQL partial-unique-index workaround).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  not_started
  in_progress
  done
  on_hold
}

enum Priority {
  high
  medium
  low
}

enum RecurrenceKind {
  fixed_interval
  case_relative
}

enum IntervalUnit {
  day
  week
  month
}

enum NonBusinessDayPolicy {
  as_is
  skip
  next_business_day
  previous_business_day
}

enum NonBusinessDaySource {
  manual
  external_api
}

model User {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tasks Task[]

  @@index([deletedAt])
  @@map("users")
}

model Case {
  id          String    @id @default(uuid())
  name        String
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date")
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tasks           Task[]
  boundTemplates  RecurringTaskTemplate[]

  @@index([deletedAt])
  @@map("cases")
}

model Task {
  id                    String     @id @default(uuid())
  title                 String
  status                TaskStatus @default(not_started)
  priority              Priority
  memo                  String?    @db.Text
  caseId                String?    @map("case_id")
  isRequiredForCase     Boolean    @default(false) @map("is_required_for_case")
  parentTaskId          String?    @map("parent_task_id")
  assigneeUserId        String?    @map("assignee_user_id")
  sourceTemplateId      String?    @map("source_template_id")
  developmentStageId    String?    @map("development_stage_id")
  scheduledDate         DateTime?  @map("scheduled_date") @db.Date
  completedAt           DateTime?  @map("completed_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  case             Case?                   @relation(fields: [caseId], references: [id])
  parentTask       Task?                   @relation("TaskChildren", fields: [parentTaskId], references: [id])
  childTasks       Task[]                  @relation("TaskChildren")
  assigneeUser     User?                   @relation(fields: [assigneeUserId], references: [id])
  sourceTemplate   RecurringTaskTemplate?  @relation(fields: [sourceTemplateId], references: [id])
  developmentStage DevelopmentStage?       @relation(fields: [developmentStageId], references: [id])

  @@unique([sourceTemplateId, scheduledDate])
  @@index([caseId])
  @@index([parentTaskId])
  @@index([completedAt])
  @@index([deletedAt])
  @@index([developmentStageId])
  @@map("tasks")
}

model RecurringTaskTemplate {
  id                   String                @id @default(uuid())
  title                String
  priority             Priority
  kind                 RecurrenceKind
  intervalUnit         IntervalUnit?         @map("interval_unit")
  intervalValue        Int?                  @map("interval_value")
  boundCaseId          String?               @map("bound_case_id")
  caseOffsetDays       Int?                  @map("case_offset_days")
  defaultMemo          String?               @db.Text @map("default_memo")
  nonBusinessDayPolicy NonBusinessDayPolicy  @map("non_business_day_policy")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")

  case           Case? @relation(fields: [boundCaseId], references: [id])
  generatedTasks Task[]

  @@index([deletedAt])
  @@map("recurring_task_templates")
}

model NonBusinessDay {
  id            String                @id @default(uuid())
  date          DateTime              @db.Date
  label         String?
  source        NonBusinessDaySource
  dateActiveKey Unsupported("date")?  @map("date_active_key")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")

  @@map("non_business_days")
}

model DevelopmentStage {
  id        String    @id @default(uuid())
  name      String
  order     Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tasks Task[]

  @@index([deletedAt])
  @@map("development_stages")
}
