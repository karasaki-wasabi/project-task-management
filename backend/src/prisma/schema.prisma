// Full domain data model.
// Physical shape follows design.md. Generated columns that Prisma cannot express
// natively are modeled as Unsupported() here; the actual column + unique index
// are hand-edited into the single init migration SQL (see
// .kiro/steering/prisma-migrations.md — do not add follow-up migrations).
//
// - `non_business_days.date_active_key`: active-date uniqueness for holidays
// - `tasks.template_case_date_active_key`: active-row uniqueness for
//   template-generated tasks on (source_template_id, case_id, scheduled_end_date).
//   Conceptual expression (exact SQL in migration hand-edit):
//   IF(deleted_at IS NULL AND source_template_id IS NOT NULL
//        AND case_id IS NOT NULL AND scheduled_end_date IS NOT NULL,
//      CONCAT(source_template_id, ':', case_id, ':',
//             DATE_FORMAT(scheduled_end_date, '%Y-%m-%d')), NULL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  not_started
  in_progress
  ready_for_handoff
  on_hold
}

enum DevelopmentStageKind {
  normal
  completed
  cancelled
}

enum Priority {
  high
  medium
  low
}

enum CaseRelativeAnchor {
  case_start
  case_end
  period_month_start
  period_month_end
}

enum NonBusinessDayPolicy {
  as_is
  skip
  next_business_day
  previous_business_day
}

enum NonBusinessDaySource {
  manual
  external_api
}

enum OperationType {
  task_created
  task_deleted
  field_changed
  comment_created
  comment_edited
  comment_deleted
}

enum FieldName {
  title
  status
  priority
  detail
  assignee
  case
  isRequiredForCase
  developmentStage
  parentTask
  scheduledEndDate
  storyPoints
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tasks                Task[]
  comments             Comment[]
  activityLogs         ActivityLog[]
  createdWorkspaces    Workspace[]       @relation("WorkspaceCreator")
  workspaceMemberships WorkspaceMember[]

  @@index([deletedAt])
  @@map("users")
}

model Workspace {
  id              String    @id @default(uuid())
  name            String
  color           String    @default("#2563eb")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  createdBy              User                    @relation("WorkspaceCreator", fields: [createdByUserId], references: [id])
  members                WorkspaceMember[]
  cases                  Case[]
  tasks                  Task[]
  recurringTaskTemplates RecurringTaskTemplate[]
  nonBusinessDays        NonBusinessDay[]
  developmentStages      DevelopmentStage[]

  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([deletedAt])
  @@map("workspace_members")
}

model Case {
  id          String    @id @default(uuid())
  name        String
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date")
  isCompleted Boolean   @default(false) @map("is_completed")
  workspaceId String    @map("workspace_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  tasks     Task[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("cases")
}

model Task {
  id                       String               @id @default(uuid())
  title                    String
  status                   TaskStatus           @default(not_started)
  priority                 Priority
  detail                   String?              @db.Text
  caseId                   String?              @map("case_id")
  isRequiredForCase        Boolean              @default(false) @map("is_required_for_case")
  parentTaskId             String?              @map("parent_task_id")
  assigneeUserId           String?              @map("assignee_user_id")
  sourceTemplateId         String?              @map("source_template_id")
  // Snapshot of the template's caseAnchor at generation time (Req 5.3).
  sourceAnchor             CaseRelativeAnchor?  @map("source_anchor")
  developmentStageId       String?              @map("development_stage_id")
  scheduledEndDate         DateTime?            @map("scheduled_end_date") @db.Date
  storyPoints              Int?                 @map("story_points")
  completedAt              DateTime?            @map("completed_at")
  workspaceId              String               @map("workspace_id")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  deletedAt                DateTime?            @map("deleted_at")
  // Active-only unique key (STORED GENERATED COLUMN + UNIQUE). Prisma cannot
  // express the generator; SQL hand-edit in migration. Soft-deleted rows yield
  // NULL so the same (sourceTemplateId, caseId, scheduledEndDate) can be recreated.
  templateCaseDateActiveKey Unsupported("varchar(191)")? @map("template_case_date_active_key")

  workspace        Workspace               @relation(fields: [workspaceId], references: [id])
  case             Case?                   @relation(fields: [caseId], references: [id])
  parentTask       Task?                   @relation("TaskChildren", fields: [parentTaskId], references: [id])
  childTasks       Task[]                  @relation("TaskChildren")
  assigneeUser     User?                   @relation(fields: [assigneeUserId], references: [id])
  sourceTemplate   RecurringTaskTemplate?  @relation(fields: [sourceTemplateId], references: [id])
  developmentStage DevelopmentStage?       @relation(fields: [developmentStageId], references: [id])
  comments         Comment[]
  activityLogs     ActivityLog[]

  @@index([workspaceId])
  @@index([caseId])
  @@index([parentTaskId])
  @@index([completedAt])
  @@index([deletedAt])
  @@index([developmentStageId])
  @@map("tasks")
}

model Comment {
  id           String    @id @default(cuid())
  taskId       String    @map("task_id")
  authorUserId String    @map("author_user_id")
  body         String    @db.Text
  editedAt     DateTime? @map("edited_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  task       Task @relation(fields: [taskId], references: [id])
  authorUser User @relation(fields: [authorUserId], references: [id])

  @@index([taskId, createdAt])
  @@map("comments")
}

model ActivityLog {
  id               String        @id @default(cuid())
  taskId           String        @map("task_id")
  actorUserId      String?       @map("actor_user_id")
  actorSourceLabel String?       @map("actor_source_label")
  operationType    OperationType @map("operation_type")
  fieldName        FieldName?    @map("field_name")
  beforeValue      String?       @db.Text @map("before_value")
  afterValue       String?       @db.Text @map("after_value")
  occurredAt       DateTime      @default(now()) @map("occurred_at")

  task      Task  @relation(fields: [taskId], references: [id])
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, occurredAt])
  @@map("activity_logs")
}

model RecurringTaskTemplate {
  id                   String               @id @default(uuid())
  title                String
  priority             Priority
  caseAnchor           CaseRelativeAnchor   @map("case_anchor")
  // Non-negative offset distance; direction is fixed per caseAnchor in application logic.
  caseOffsetDays       Int                  @map("case_offset_days")
  defaultDetail        String?              @db.Text @map("default_detail")
  nonBusinessDayPolicy NonBusinessDayPolicy @map("non_business_day_policy")
  isActive             Boolean              @default(true) @map("is_active")
  workspaceId          String               @map("workspace_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  generatedTasks Task[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("recurring_task_templates")
}

model NonBusinessDay {
  id            String                @id @default(uuid())
  date          DateTime              @db.Date
  label         String?
  source        NonBusinessDaySource
  workspaceId   String                @map("workspace_id")
  // Active-date uniqueness is (workspace_id, date_active_key) via hand-edited
  // UNIQUE INDEX in migration SQL. date_active_key remains a STORED GENERATED
  // COLUMN; do not recreate via `prisma migrate dev` (drift risk).
  dateActiveKey Unsupported("date")?  @map("date_active_key")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("non_business_days")
}

model DevelopmentStage {
  id          String                @id @default(uuid())
  name        String
  order       Int
  kind        DevelopmentStageKind  @default(normal)
  workspaceId String                @map("workspace_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  tasks     Task[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("development_stages")
}
