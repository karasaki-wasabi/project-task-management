# Copy this file to `.env` (gitignored) and fill in local values before
# running `docker compose up`. Never commit real secrets.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=task_delivery_management
MYSQL_USER=app_user
MYSQL_PASSWORD=changeme_app
MYSQL_PORT=3306

# --- Backend ---
BACKEND_PORT=3000
# LOG_LEVEL: debug | info | warn | error (Requirements 10.6)
LOG_LEVEL=debug
# 32-byte development-only secret encoded as 64 hexadecimal characters.
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:3001
# COOKIE_SECURE: true | false
COOKIE_SECURE=false

# --- Frontend ---
FRONTEND_PORT=3001
